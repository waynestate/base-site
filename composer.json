{
    "name": "waynestate/base",
    "description": "Wayne State University Base Laravel Site",
    "keywords": [
        "framework",
        "laravel",
        "base"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "fakerphp/faker": "^1.24",
        "guzzlehttp/guzzle": "^7.14",
        "laravel/framework": "^13.20",
        "laravel/tinker": "^3.0",
        "predis/predis": "^3.5",
        "waynestate/apdatetime": "^1.1",
        "waynestate/display-menu": "~1.0",
        "waynestate/error-403": "~1.1",
        "waynestate/error-404": "~1.1",
        "waynestate/error-429": "^1.0",
        "waynestate/error-500": "~1.1",
        "waynestate/formy-parser": "~1.0",
        "waynestate/image-faker": "~1.0",
        "waynestate/news-api-php": "~2.0",
        "waynestate/parse-menu": "~1.2",
        "waynestate/parse-promos": "~2.0",
        "waynestate/people-api-php": "~1.0",
        "waynestate/waynestate-api": "~1.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/envoy": "^2.12",
        "laravel/pint": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "php-coveralls/php-coveralls": "^2.9",
        "phpunit/phpunit": "^11.5",
        "laravel/pail": "^1.2"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Factories\\": "factories/",
            "Styleguide\\": "styleguide/",
            "Contracts\\": "contracts"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
